{
  "name": "@qrlwallet/connect-ui",
  "version": "0.4.0",
  "packageManager": "npm@10.9.8",
  "description": "Framework-agnostic pairing modal for @qrlwallet/connect: <qrl-pairing-modal> web component plus a one-line showPairingModal() helper",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./wallets": {
      "types": "./dist/wallets.d.ts",
      "import": "./dist/wallets.mjs",
      "require": "./dist/wallets.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "import": "./dist/extension.mjs",
      "require": "./dist/extension.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/wallets.ts src/extension.ts --format cjs,esm --dts --clean",
    "typecheck": "tsc --noEmit && npm run typecheck:test",
    "typecheck:test": "tsc --noEmit -p tsconfig.eslint.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --config eslint.config.mjs . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint --config eslint.config.mjs . --report-unused-disable-directives --max-warnings 0 --fix",
    "format": "prettier --write src/ test/",
    "format:check": "prettier --check src/ test/",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build",
    "lint:ratchet": "node ../scripts/lint-ratchet.mjs --dir ui --check",
    "lint:ratchet:update": "node ../scripts/lint-ratchet.mjs --dir ui"
  },
  "keywords": [
    "qrl",
    "zond",
    "wallet",
    "connect",
    "dapp",
    "qr-code",
    "web-component",
    "modal"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DigitalGuards/myqrlwallet-connect.git",
    "directory": "ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "@qrlwallet/connect": ">=4.0.0 <6"
  },
  "peerDependenciesMeta": {
    "@qrlwallet/connect": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@qrlwallet/connect": "file:..",
    "@types/qrcode": "^1.5.5",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^17.13.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "vitest": {
      "vite": "7.3.7"
    }
  }
}
