{
  "name": "@qrlwallet/connect",
  "version": "5.1.2",
  "packageManager": "npm@10.9.8",
  "description": "Connect your dApp to QRL Wallet via QR code or deep link",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit && npm run typecheck:test",
    "typecheck:test": "tsc --noEmit -p tsconfig.eslint.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --config eslint.config.mjs src test scripts \"*.mjs\" vitest.config.ts --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint --config eslint.config.mjs src test scripts \"*.mjs\" vitest.config.ts --report-unused-disable-directives --max-warnings 0 --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "size": "size-limit",
    "size:check": "size-limit --highlight-less",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build",
    "lint:ratchet": "node scripts/lint-ratchet.mjs --check",
    "lint:ratchet:update": "node scripts/lint-ratchet.mjs"
  },
  "keywords": [
    "qrl",
    "zond",
    "wallet",
    "connect",
    "dapp",
    "web3",
    "eip-1193"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DigitalGuards/myqrlwallet-connect.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@noble/post-quantum": "^0.5.4",
    "@theqrl/mldsa87": "^2.2.0",
    "eventemitter3": "^5.0.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@size-limit/file": "^11.0.0",
    "@theqrl/wallet.js": "^6.3.0",
    "@types/node": "^25.3.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^17.13.0",
    "prettier": "^3.4.0",
    "size-limit": "^11.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "vitest": {
      "vite": "7.3.5"
    }
  },
  "size-limit": [
    {
      "path": "dist/index.mjs",
      "limit": "100 kB"
    }
  ],
  "engines": {
    "node": ">=20.19.0"
  }
}
